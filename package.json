{
  "name": "brandhub-cafe-resto",
  "private": true,
  "type": "module",
  "description": "BrandHub Café (cafe.brandhub.ma) and BrandHub Resto (resto.brandhub.ma): two products, one kit.",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/cafe/*",
    "apps/resto/*",
    "apps/station",
    "tools"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.{js,mjs,cjs}\" \"apps/*/*/test/**/*.test.{js,mjs,cjs}\" \"apps/station/test/**/*.test.{js,mjs,cjs}\" \"tools/test/**/*.test.{js,mjs,cjs}\" && vitest run",
    "typecheck": "node tools/scripts/typecheck.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n": "node tools/scripts/i18n.mjs",
    "budgets": "node tools/scripts/budgets.mjs",
    "e2e": "playwright test --pass-with-no-tests",
    "dev:cafe": "node tools/scripts/dev-worker.mjs cafe",
    "dev:resto": "node tools/scripts/dev-worker.mjs resto",
    "gate": "npm run typecheck && npm run lint && npm run i18n && npm test && npm run budgets",
    "contrast": "node tools/scripts/contrast.mjs",
    "fonts": "node tools/scripts/fonts.mjs",
    "styleguide:cafe": "npm run styleguide -w @brandhub/cafe-web",
    "styleguide:resto": "npm run styleguide -w @brandhub/resto-web",
    "size:ui": "node tools/scripts/ui-size.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261010.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
